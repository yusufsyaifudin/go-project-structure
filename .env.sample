# ─── HTTP server ──────────────────────────────────────────────────────────────
PORT=3001
# Public base URL of the service, including trailing slash.
# Used to build the swagger spec URL in the swagger UI.
BASE_URL=http://localhost:3001/
LOG_LEVEL=DEBUG   # DEBUG | INFO | WARN | ERROR
APP_ENV=staging      # demo | staging | production — sets DeploymentEnvironmentName in OTel resource

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Required. Standard lib/pq DSN.
POSTGRES_DSN=postgres://wallet:wallet_secret@localhost:5432/wallet_db?sslmode=disable

# ─── OpenTelemetry ────────────────────────────────────────────────────────────
# Exporter: NOOP | STDOUT | JAEGER | OTLP | OTLP_GRPC
OTEL_EXPORTER=OTLP_GRPC

# JAEGER exporter — HTTP Thrift collector endpoint.
OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces

# OTLP HTTP exporter — host:port only, no scheme or path.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
# To point OTLP HTTP directly at Jaeger's OTLP receiver:
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:14318

# OTLP gRPC exporter — host:port only.
OTEL_EXPORTER_OTLP_GRPC_ENDPOINT=localhost:4317
